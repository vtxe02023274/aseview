{
  "name": "aseview",
  "version": "0.1.0",
  "private": true,
  "description": "View Aseprite files in the browser and export sprite sheets.",
  "license": "MIT",
  "author": "冷牛",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --target=es2022 --minify --sourcemap --outfile=site/main.js && node -e \"const f=require('fs');f.copyFileSync('public/index.html','site/index.html');f.copyFileSync('public/demo.aseprite','site/demo.aseprite');f.copyFileSync('public/stack-demo.aseprite','site/stack-demo.aseprite')\"",
    "demo": "node tools/make-demo.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build:cli": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "bin": {
    "aseview": "dist/bin.js"
  },
  "files": [
    "dist"
  ]
}
